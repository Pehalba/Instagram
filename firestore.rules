rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Quem abre o estúdio entra de forma anônima. Qualquer pessoa com o site
    // publicado consegue ler e gravar até estas regras ficarem mais fechadas.
    match /series/{id} {
      allow read, write: if request.auth != null;
    }
    match /subseries/{id} {
      allow read, write: if request.auth != null;
    }
    match /ideias/{id} {
      allow read, write: if request.auth != null;
    }
    match /mensagensParceria/{id} {
      allow read, write: if request.auth != null;
    }
    match /midiakits/{perfil} {
      allow read, write: if request.auth != null;
      match /partes/{parte} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
