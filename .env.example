# Cole os valores do app Web em Firebase → Configurações do projeto.
# Com estes campos preenchidos, o estúdio grava no Firestore.
# Sem eles, continua no banco local prisma/dev.db.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# O servidor local continua usando este arquivo.
DATABASE_URL="file:./prisma/dev.db"
